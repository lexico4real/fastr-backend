{
  "name": "fastr-backend",
  "version": "0.0.1",
  "description": "FASTR is a dual-market recruitment platform that connects university students with local businesses for internship, part-time, and freelance work opportunities. It simplifies the recruitment process, helping students gain experience and businesses find on-demand student.",
  "author": "Oluyinka Abubakar",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:stage": "NODE_ENV=stage nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bull": "^11.0.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/cookie-session": "^2.0.49",
    "@types/multer": "^1.4.12",
    "autocannon": "^8.0.0",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.6.1",
    "compression": "^1.8.0",
    "config": "^3.3.12",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.0",
    "cron": "^4.3.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "ioredis": "^5.6.1",
    "js-yaml": "^4.1.0",
    "jsontoxml": "^1.0.1",
    "log4js": "^6.9.1",
    "mongodb": "^6.16.0",
    "mongoose": "^8.15.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nestjs-cookie-session": "^4.0.0",
    "nestjs-stripe": "^1.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.15.5",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "request": "^2.88.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "skeleton": "file:",
    "stripe": "^18.0.0",
    "typeorm": "^0.3.22",
    "uuid": "^11.1.0",
    "webpack": "^5.99.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/swagger": "^11.1.5",
    "@nestjs/testing": "^11.1.0",
    "@types/compression": "^1.7.5",
    "@types/config": "^3.3.5",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.1",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/mongodb": "^4.0.7",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.5",
    "@types/request": "^2.48.12",
    "@types/speakeasy": "^2.0.10",
    "@types/stripe": "^8.0.417",
    "@types/supertest": "^6.0.3",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.7.0",
    "node-notifier": "^10.0.1",
    "nodemailer": "^6.10.1",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "2.8.1",
    "typescript": "^5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
